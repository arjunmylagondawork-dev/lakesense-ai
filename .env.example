# Copy to .env and fill in ONE provider. Default "mock" needs no key.
LAKESENSE_LLM_PROVIDER=mock          # mock | openai | anthropic | bedrock
# LAKESENSE_LLM_MODEL=               # optional model override

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Amazon Bedrock (uses your normal AWS credentials chain)
# AWS_REGION=us-east-1
# LAKESENSE_LLM_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0

LAKESENSE_LOG_LEVEL=INFO
